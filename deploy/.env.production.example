# Salin ke .env di VPS (JANGAN commit file .env asli ke git).
# Generate JWT_SECRET acak dengan: openssl rand -base64 48

DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="GANTI_DENGAN_HASIL_openssl_rand_-base64_48"
NODE_ENV="production"

# Set "false" HANYA sementara kalau situs masih diakses lewat http:// biasa
# (belum ada domain/SSL). Browser menolak cookie sesi kalau ini "true" tapi
# koneksinya bukan https:// — ganti balik ke "true" setelah HTTPS aktif.
USE_HTTPS="true"
